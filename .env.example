# Copy this file to .env (for local development) and fill in real values.
# In production (Vercel), set these as Environment Variables in the project
# settings instead of committing a .env file.

# --- Database (Supabase PostgreSQL) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the "Transaction" pooler connection string (port 6543) for serverless.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- NextAuth ---
# Local dev: http://localhost:3000
# Production: your Vercel deployment URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Anthropic Claude API (OPTIONAL — console.anthropic.com -> API Keys) ---
# Leave this unset (or delete the line) to run the app for free: email
# classification automatically falls back to a built-in offline, rule-based
# classifier with no API cost. Set a key here to upgrade to Claude for more
# accurate classification, extraction, and real summaries (paid, usage-based).
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# --- Vercel Cron Secret ---
# Generate with: openssl rand -hex 32
# Protects /api/cron/sync from being triggered by anyone but Vercel Cron.
CRON_SECRET="your-cron-secret-generate-randomly"

# --- Token encryption key ---
# Generate with: openssl rand -base64 32
# Encrypts Gmail OAuth access/refresh tokens before they're stored in the
# database (on top of Supabase's own encryption at rest). Required.
TOKEN_ENCRYPTION_KEY="your-token-encryption-key-generate-with-openssl-rand-base64-32"
