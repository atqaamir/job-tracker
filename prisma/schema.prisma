generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  applications  JobApplication[]
  syncLogs      SyncLog[]
  notifications Notification[]
  syncSettings  SyncSettings?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  VIEWED
  RECRUITER_CONTACTED
  ASSESSMENT
  PHONE_SCREEN
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  GHOSTED
}

enum EmailCategory {
  APPLICATION_CONFIRMATION
  RECRUITER_OUTREACH
  INTERVIEW_INVITATION
  INTERVIEW_FOLLOWUP
  CODING_ASSESSMENT
  OFFER
  REJECTION
  REQUEST_FOR_INFO
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  REMOTE
}

model JobApplication {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  company         String
  position        String
  status          ApplicationStatus @default(APPLIED)
  // The most advanced non-terminal stage ever reached (e.g. TECHNICAL_INTERVIEW),
  // preserved even after `status` later moves to REJECTED/WITHDRAWN/GHOSTED —
  // otherwise a rejection after an interview looks identical to a rejection
  // with no interview at all.
  furthestStage   ApplicationStatus?
  dateApplied     DateTime?
  dateLastEmail   DateTime?

  recruiterName   String?
  recruiterEmail  String?

  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  location        String?
  employmentType  EmploymentType?
  source          String?

  notes           String?           @db.Text
  isArchived      Boolean           @default(false)

  aiSummary       String?           @db.Text
  aiSentiment     String?
  aiNextAction    String?
  aiDeadline      DateTime?

  emails          EmailRecord[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([company])
}

model EmailRecord {
  id              String         @id @default(cuid())
  applicationId   String
  application     JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  gmailMessageId  String         @unique
  gmailThreadId   String?
  subject         String?
  fromName        String?
  fromEmail       String?
  toEmail         String?
  receivedAt      DateTime
  snippet         String?        @db.Text
  bodyText        String?        @db.Text
  bodyHtml        String?        @db.Text
  gmailLink       String?

  category        EmailCategory?
  aiSummary       String?        @db.Text
  aiConfidence    Float?
  isProcessed     Boolean        @default(false)

  createdAt       DateTime       @default(now())

  @@index([applicationId])
  @@index([gmailThreadId])
}

model SyncLog {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  status              String    @default("running")
  error               String?   @db.Text
  // Set by POST /api/sync/cancel; the running sync's loop polls this and
  // stops early, marking itself "cancelled" instead of "completed".
  cancelRequested     Boolean   @default(false)
  // Bumped on every progress update while a sync is running (see
  // src/lib/sync.ts). Lets /api/sync/status detect a "running" row whose
  // job actually died (crash, server restart, serverless timeout) without
  // ever reaching a terminal status — see STALE_RUNNING_MS there.
  updatedAt           DateTime  @updatedAt

  emailsScanned       Int       @default(0)
  emailsProcessed     Int       @default(0)
  applicationsNew     Int       @default(0)
  applicationsUpdated Int       @default(0)

  summary             Json?

  @@index([userId])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String
  title         String
  message       String   @db.Text
  isRead        Boolean  @default(false)
  applicationId String?

  createdAt     DateTime @default(now())

  @@index([userId, isRead])
}

model SyncSettings {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastSyncAt      DateTime?
  syncFrequency   Int       @default(60)
  autoSync        Boolean   @default(true)
  gmailQuery      String    @default("job OR application OR interview OR offer OR rejection OR recruiter OR position OR opportunity")
  daysToLookBack  Int       @default(365)

  // Per-user AI classification config. anthropicApiKey is encrypted at rest
  // (same AES-256-GCM scheme as OAuth tokens — see src/lib/crypto.ts) and
  // never returned to the client. Falls back to the server's
  // ANTHROPIC_API_KEY env var when unset, so existing single-deployer setups
  // keep working without configuring a key per user.
  aiEnabled       Boolean   @default(false)
  aiModel         String    @default("claude-haiku-4-5")
  anthropicApiKey String?   @db.Text

  updatedAt       DateTime  @updatedAt
}
